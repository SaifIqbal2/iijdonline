$(this).closest("section").find(".content").find('a').attr('tabindex','0');$(this).closest("section").find(".content").find('table').attr('tabindex','0');$(this).closest("section").find(".content").find('.sectionTitle').attr('tabindex','0');$(this).closest("section").find(".content").find("section").find(".sectionTitle").attr('tabindex','0');});});$('*').find('.sectionTitle').attr('tabindex','0');$('*').find('.sectionNavigator').attr('tabindex','-1');$('*').find('.sectionHeading').attr('tabindex','-1');$('*').find('#jumpToSectionButton').attr('tabindex','-1');}
function tabNavAccess(tab){if(tab.find('.tabtitle').closest('h3').length==0){tab.find('.tabtitle').parent('div').contents().unwrap();tab.find('.tabtitle').wrap('<h3></h3>');tab.find('a').attr('aria-selected','true');tab.addClass('active');var tabPanel=$(tab).attr('aria-controls');$('#'+tabPanel).attr('aria-hidden','false');$('#'+tabPanel).addClass('active');tab.find('.tabtitle').attr('tabindex','0');}if(tab.siblings('li').find('.tabtitle').parent('h3').length!=0){tab.siblings('li').find('.tabtitle').parent('h3').contents().unwrap();tab.siblings('li').find('a').attr('aria-selected','false');tab.siblings('li').each(function(){var tabPanel=$(this).attr('aria-controls');$('#'+tabPanel).removeClass('active');$('#'+tabPanel).attr('aria-hidden','true');if($(this).find('.tabtitle').parent('h3').length==0&&$(this).find('.tabtitle').parent('div').length==0){$(this).find('.tabtitle').wrap('<div></div>');}
$(this).removeClass('active');$(this).find('.tabtitle').attr('tabindex','-1');});}}
function setTabPanelList($tabsArray,$panels){var keys=new keyCodes();$tabsArray.keyup(function(e){e=e||window.event;var tab=$(this).closest("li");if(e.keyCode===keys.tab){$(tab).find('.tabtitle').focus();return true;}
tabNavAccess(tab);tab.find('.tabtitle').focus();});$tabsArray.keydown(function(e){e=e||window.event;var key=e.which||e.keyCode;var $node,$tab;if(key==keys.down||key==keys.right||key==keys.up||key==keys.left||key==keys.end||key==keys.space||key==keys.home){if(key==keys.down||key==keys.right){$node=$(this).nextUntil(function(){return $(this).is(":visible");});$node=!isNullOrEmptyOrWhitespace($node.text())?$node:$(this);if($(this).index()==$(this).parents("ul.tab-nav").find("li:visible:last").index()){$tab=$(this).parents("ul").find('li:visible:first');}
else{$tab=$node.next();}}
else if(key==keys.up||key==keys.left){if(e.ctrlKey){e.stopPropagation();return false;}else{$node=$(this).prevUntil(function(){return $(this).is(":visible");});$node=!isNullOrEmptyOrWhitespace($node.text())?$node:$(this);if($(this).index()==$(this).parents("ul.tab-nav").find("li:visible:first").index()){$tab=$(this).parent().find('li:visible:last');}else{$tab=$node.prev();}}}
else if(key==keys.home){$tab=$(this).parents("ul").find('li:visible:first');}
else if(key==keys.end){$tab=$(this).parents("ul").find('li:visible:last');}
else if(key==keys.space){$(this).find(".tabtitle").click();}
if(!(e.ctrlKey&&(key===keys.left||key===keys.up))){nextTab($tab);$tab.find('.tabtitle').focus();e.stopPropagation();return false;}}
if(key==keys.enter){$(this).find(".tabtitle").click();}
return true;});$tabsArray.on("click",function(e){nextTab($(this));});$panels.keydown(function(e){e=e||window.event;var key=e.which||e.keyCode;switch(key){case keys.up:case keys.left:{if(!e.ctrlKey){return true;}
var $currentTab=$('#'+$(this).attr('aria-labelledby'));tabNavAccess($currentTab);$currentTab.find('.tabtitle').focus();e.stopPropagation();return false;}}});}
