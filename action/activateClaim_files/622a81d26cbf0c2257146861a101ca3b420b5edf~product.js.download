{var integerRegex=/^\d+$/;var elem=document.getElementById(fieldId);var val=elem.value;if(!val||val==""||integerRegex.test(val))
{return true;}
else
{alert(fields[fieldId].name+" must be an integer value");elem.value="";return false;}}
